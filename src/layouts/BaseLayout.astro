---
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import '../styles/photo-frame.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultImage from '../assets/hero/mayami-tripadvisor.jpg';
interface Props { title?: string; description?: string; hero?: boolean; noindex?: boolean; image?: ImageMetadata; }
const { title, description = site.description, hero = false, noindex = false, image } = Astro.props;
const pageTitle = title ? `${title} | Buchanan P.E. Consulting` : 'Buchanan P.E. Consulting — MEP Engineering in Florida';
const canonical = new URL(Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname, Astro.site);
const socialImage = await getImage({ src: image || defaultImage, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const schema = { '@context': 'https://schema.org', '@type': 'ProfessionalService', name: site.legalName, url: Astro.site?.href, description: site.description, telephone: '+1-954-590-3300', email: site.email, foundingDate: '2001', address: { '@type': 'PostalAddress', streetAddress: site.address, addressLocality: 'Margate', addressRegion: 'FL', postalCode: '33063', addressCountry: 'US' }, areaServed: { '@type': 'State', name: 'Florida' } };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#191c18" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(socialImage.src, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header hero={hero} />
    <main id="main"><slot /></main>
    <Footer />
    <script src="../scripts/motion.ts"></script>
  </body>
</html>
