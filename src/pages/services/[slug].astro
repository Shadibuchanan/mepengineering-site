---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PillLink from '../../components/PillLink.astro';
import Icon from '../../components/Icon.astro';
import { services, type Service } from '../../data/services';
import PhotoFrame from '../../components/PhotoFrame.astro';
import { Image } from 'astro:assets';
import { serviceImages, mechanicalDetailImage, sprinklerDetailImage } from '../../data/legacy-images';
export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
interface Props { service: Service; }
const { service } = Astro.props;
const otherServices = services.filter((item) => item.slug !== service.slug);
const serviceImage = serviceImages[service.slug];
const detailImage = service.slug === 'mechanical' ? mechanicalDetailImage : service.slug === 'fire-sprinkler' ? sprinklerDetailImage : undefined;
---
<BaseLayout title={service.name} description={`${service.summary} Buchanan P.E. Consulting provides ${service.name.toLowerCase()} for projects throughout Florida.`} image={serviceImage.image}>
  <section class="container page-intro service-intro" data-stagger>
    <a href="/services/" class="back-link" data-reveal><Icon name="arrowLeft" /> All services</a>
    <p class="eyebrow" data-reveal>Engineering services</p>
    <h1 class="display-title" data-reveal>{service.headline}<br /><em>{service.accent}</em></h1>
    <p class="service-deck" data-reveal>{service.introduction}</p>
  </section>

  <section class="container section split-layout service-overview">
    <div class="service-aside">
      <PhotoFrame class="service-photo" src={serviceImage.image} alt={serviceImage.alt} caption={serviceImage.caption} variant="natural" loading="eager" />
      {detailImage && <figure class="service-detail" style={{ '--detail-width': `${Math.min(detailImage.image.width, 220)}px` }} data-reveal="image"><Image src={detailImage.image} alt={detailImage.alt} width={detailImage.image.width} format="webp" quality={88} loading="lazy" /><figcaption>{detailImage.caption}</figcaption></figure>}
    </div>
    <div class="overview-content">
      <h2 class="section-title" data-reveal>Design scope</h2>
      <div class="overview-text" data-stagger>{service.paragraphs.map((paragraph) => <p class="body-copy" data-reveal>{paragraph}</p>)}</div>
      <PillLink href={`/contact/?service=${encodeURIComponent(service.shortName)}#inquiry`}>Discuss your project</PillLink>
    </div>
  </section>

  <section class="capabilities-section">
    <div class="container section split-layout">
      <p class="eyebrow" data-reveal>{service.shortName}</p>
      <div>
        <h2 class="section-title" data-reveal>Services and<br /><em>design documentation</em></h2>
        <ul class="capabilities" data-stagger>{service.capabilities.map((capability, index) => <li data-reveal><span>{String(index + 1).padStart(2, '0')}</span>{capability}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="container section related-services">
    <div class="related-heading" data-stagger><h2 class="section-title" data-reveal>Other engineering <em>services</em></h2></div>
    <div class="related-links" data-stagger>{otherServices.map((item) => <a href={`/services/${item.slug}/`} data-reveal><span>{item.shortName}</span><Icon name="arrowUpRight" /></a>)}</div>
  </section>
</BaseLayout>

<style>
  .service-intro { position: relative; }
  .back-link { display: inline-flex; align-items: center; gap: 9px; font-size: 14px; margin-bottom: 32px; color: var(--muted, #646b61); text-decoration: none; }
  .back-link:hover { color: #191c18; }
  .service-intro h1 { margin-top: 28px; }
  .service-deck { font-size: 18px; line-height: 1.8; max-width: 780px; margin: 28px 0 0; }
  .service-overview { border-top: 0; grid-template-columns: 1fr 1.1fr; gap: clamp(35px, 6vw, 85px); padding-top: 0; align-items: start; }
  .service-aside { min-width: 0; }
  .service-detail { margin-top: 30px; display: grid; grid-template-columns: minmax(0, var(--detail-width)) minmax(0, 1fr); align-items: center; gap: 22px; max-width: 440px; }
  .service-detail img { width: 100%; height: auto; border-radius: 5px; object-fit: contain; }
  .service-detail figcaption { font-size: 14px; line-height: 1.7; color: var(--muted); max-width: 180px; }
  .overview-content > .eyebrow { margin-bottom: 22px; }
  .overview-text { display: grid; grid-template-columns: 1fr; gap: 20px; margin: 30px 0; }
  .overview-text p { margin: 0; }
  .capabilities-section { background: #e9ede4; }
  .capabilities { padding: 0; margin: 38px 0 0; list-style: none; }
  .capabilities li { display: flex; align-items: baseline; gap: 28px; padding: 22px 0; border-top: 1px solid #cad0c3; font-size: 18px; }
  .capabilities li span { font-size: 14px; color: #62695d; width: 22px; flex-shrink: 0; }
  .related-heading { display: flex; align-items: start; justify-content: space-between; gap: 40px; margin-bottom: 44px; }
  .related-links { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 45px; }
  .related-links a { display: flex; align-items: center; justify-content: space-between; gap: 20px; border-top: 1px solid var(--line, #d9ddd4); padding: 23px 0; text-decoration: none; font-size: 18px; }
  .related-links a:hover span { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 760px) { .service-deck { margin-left: 0; } .overview-text { grid-template-columns: 1fr; gap: 20px; } .related-heading { display: block; } .related-heading h2 { margin-top: 24px; } .related-links { grid-template-columns: 1fr 1fr; column-gap: 25px; } }
  @media (max-width: 480px) { .related-links { grid-template-columns: 1fr; } .service-detail { grid-template-columns: minmax(0, var(--detail-width)); gap: 14px; } .service-detail figcaption { max-width: none; } }
  @media (max-width: 800px) { .service-overview { grid-template-columns: 1fr; gap: 45px; } }
</style>
