---
import BaseLayout from '../layouts/BaseLayout.astro';
import PillLink from '../components/PillLink.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import foxtail from '../assets/projects/foxtail-coffee-sarasota.webp';
---
<BaseLayout title="Page not found" noindex><section class="container page-intro missing"><p class="eyebrow">Error 404</p><h1 class="display-title">Page <em>not found</em></h1><p class="body-copy muted">This page may have moved or the link may be incorrect. Return to the homepage or browse our project portfolio.</p><div><PillLink href="/">Back to home</PillLink><PillLink href="/projects/">View projects</PillLink></div></section><PhotoFrame class="container missing-photo" src={foxtail} alt="Seating and coffee counter at Foxtail Coffee Sarasota" caption="Foxtail Coffee Co. · Sarasota, Florida" loading="eager" /></BaseLayout>
<style>.missing { min-height:55vh; }.missing > div { display:flex; flex-wrap:wrap; gap:16px; margin-top:35px; }:global(.missing-photo) { margin-bottom:90px; }</style>
