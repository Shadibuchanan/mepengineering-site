---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/photo-frame.css';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  position?: string;
  variant?: 'natural' | 'wide' | 'compact';
}

const {
  src,
  alt,
  caption,
  class: className,
  loading = 'lazy',
  position = 'center',
  variant = 'natural',
} = Astro.props;

// Always include the source-capped maximum so small supplied photographs have
// a valid candidate, while larger originals receive useful responsive sizes.
// Large originals also serve high-density desktop screens without enlargement.
const maxWidth = Math.min(src.width, 2880);
const widths = [...new Set([360, 640, 960, 1280, 1600, 1920, 2400, 2880]
  .filter(width => width < maxWidth)
  .concat(maxWidth))];
// Both dimensions matter for cover crops: a tall crop can enlarge an image
// even when its element width is smaller than the original file's width.
const cropRatio = variant === 'wide' ? 2.6 : variant === 'compact' ? 1.6 : src.width / src.height;
const mobileRatio = variant === 'wide' ? 1.35 : variant === 'compact' ? 1.25 : cropRatio;
const displayWidth = Math.min(src.width, src.height * cropRatio);
const mobileWidth = Math.min(src.width, src.height * mobileRatio);
---

<figure class:list={['photo-frame', `photo-frame--${variant}`, className]} style={{ '--photo-width': `${displayWidth}px`, '--photo-mobile-width': `${mobileWidth}px`, '--photo-ratio': `${src.width} / ${src.height}` }} data-reveal="image">
  <div class:list={['photo-frame__crop', { 'photo-cutout': src.width >= 600 }]} style={{ '--photo-position': position }}>
    <Image
      class="photo-frame__image"
      src={src}
      alt={alt}
      width={maxWidth}
      widths={widths}
      sizes="90vw"
      format="webp"
      quality={88}
      loading={loading}
      fetchpriority={loading === 'eager' ? 'high' : undefined}
      decoding="async"
    />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .photo-frame {
    min-width: 0;
    max-width: min(100%, var(--photo-width), 1360px);
    margin-inline: auto;
  }

  .photo-frame__crop {
    aspect-ratio: 2.6;
    overflow: hidden;
    border-radius: clamp(14px, 1.8vw, 26px);
  }

  .photo-frame--compact .photo-frame__crop {
    aspect-ratio: 1.6;
  }
  .photo-frame--natural .photo-frame__crop { aspect-ratio: var(--photo-ratio); }

  .photo-frame__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--photo-position, center);
  }

  figcaption {
    padding-top: 14px;
    color: inherit;
    opacity: .8;
    font-size: 15px;
    line-height: 1.65;
  }

  @media (max-width: 700px) {
    .photo-frame { max-width: min(100%, var(--photo-mobile-width)); }
    .photo-frame__crop { aspect-ratio: 1.35; }
    .photo-frame--compact .photo-frame__crop { aspect-ratio: 1.25; }
    .photo-frame--natural .photo-frame__crop { aspect-ratio: var(--photo-ratio); }
    figcaption { padding-top: 10px; }
  }
</style>
