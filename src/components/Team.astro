---
import { Image } from 'astro:assets';
import raja from '../assets/team/raja-placeholder.webp';
import rashad from '../assets/team/rashad-placeholder.webp';
const engineers = [
  { name: 'Raja Buchanan', portrait: raja },
  { name: 'Rashad Buchanan', portrait: rashad },
];
---
<section class="container team-section" aria-labelledby="team-title">
  <div class="team-heading" data-reveal>
    <h2 id="team-title">Our <em>engineers.</em></h2>
    <p class="team-intro">Mechanical, electrical and plumbing design, coordinated with your project team.</p>
  </div>
  <div class="team-grid" data-stagger>
    {engineers.map(engineer => <figure class="team-profile" data-reveal>
      <div class="team-portrait photo-cutout"><Image src={engineer.portrait} alt={`Portrait placeholder for ${engineer.name}; actual photo coming soon`} widths={[320, 480, 640, 800]} sizes="(max-width: 600px) 90vw, (max-width: 900px) 43vw, 28vw" width={640} format="webp" quality={85} loading="lazy" /></div>
      <figcaption><span class="portrait-note">Portrait coming soon</span><h3>{engineer.name}</h3><p>Engineer</p></figcaption>
    </figure>)}
  </div>
</section>
<style>
  .team-section { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; padding-block: 80px 100px; }
  .team-heading h2 { font-size: clamp(34px, 3.6vw, 48px); line-height: 1.12; }
  .team-intro { font-size: 18px; color: var(--muted); max-width: 320px; line-height: 1.75; margin-top: 24px; }
  .team-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; min-width: 0; }
  .team-portrait { aspect-ratio: 4 / 5; border-radius: 18px; overflow: hidden; background: #dadbd6; }
  .team-portrait img { width: 100%; height: 100%; object-fit: cover; }
  .team-profile figcaption { padding-top: 16px; }
  .portrait-note { font-size: 14px; color: var(--muted); }
  .team-profile h3 { font-size: clamp(22px, 2.1vw, 29px); letter-spacing: -.035em; margin-top: 8px; line-height: 1.2; }
  .team-profile figcaption p { font-size: 16px; color: var(--muted); margin-top: 7px; }
  @media (max-width: 900px) { .team-section { grid-template-columns: 1fr; gap: 36px; } .team-intro { max-width: 450px; } }
  @media (max-width: 600px) { .team-section { padding-block: 65px; } .team-grid { grid-template-columns: 1fr; gap: 40px; } .team-profile h3 { font-size: 28px; } }
</style>
